# Дистрибутивы MavixDesktop — кладутся вручную/CI в public/downloads/
# (см. server.js: /downloads/* маршруты). Бинарники в репозиторий не
# коммитим, только .gitkeep чтобы директория существовала.
public/downloads/*
!public/downloads/.gitkeep
